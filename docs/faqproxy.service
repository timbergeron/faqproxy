[Unit]
Description=FAQProxy NetQuake relay
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=faqproxy
Group=faqproxy
WorkingDirectory=/var/lib/faqproxy
StateDirectory=faqproxy
StateDirectoryMode=0750
ExecStart=/usr/local/bin/faqproxy --listen 0.0.0.0:26000 --record-dir /var/lib/faqproxy/demos quake.example.net:26000
Restart=on-failure
RestartSec=2
UMask=0027
LimitNOFILE=256
NoNewPrivileges=true
CapabilityBoundingSet=
LockPersonality=true
MemoryDenyWriteExecute=true
PrivateDevices=true
PrivateTmp=true
ProtectClock=true
ProtectControlGroups=true
ProtectSystem=strict
ProtectHome=true
ProtectHostname=true
ProtectKernelLogs=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectProc=invisible
ProcSubset=pid
RestrictAddressFamilies=AF_INET AF_UNIX
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
